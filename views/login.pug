extends layout

block content
  section.box
    h2 Login
    p Enter your information to log in.

    if message
      p.message-box= message

    if error
      p.error-box= error

    form(action="/login", method="post")
      .form-group
        label(for="email") Email
        input#email(type="email", name="email", placeholder="Enter email", value=formData.email, required)

      .form-group
        label(for="password") Password
        input#password(type="password", name="password", placeholder="Enter password", required)

      button.button(type="submit") Login
