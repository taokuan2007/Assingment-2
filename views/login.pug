extends layout

block content
  section.box
    h2 Login
    p Enter your information to log in.

    form(action="#", method="post")
      .form-group
        label(for="email") Email
        input#email(type="email", name="email", placeholder="Enter email")

      .form-group
        label(for="password") Password
        input#password(type="password", name="password", placeholder="Enter password")

      button.button(type="submit") Login
